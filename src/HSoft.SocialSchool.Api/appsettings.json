{
  "Keycloak": {
    "_comment": "Valores de ejemplo. La Authority y la Audience reales se configuran en User Secrets o en variables de entorno; nunca se guardan aquí.",
    "Authority": "https://<keycloak-host>/realms/<realm>",
    "Audience": "SocialSchool-Api"
  },
  "ConnectionStrings": {
    "MyCompany": "Server=<host>;Port=3306;Database=socialschool;User Id=<usuario>;Password=<contraseña>"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ]
  }
}
