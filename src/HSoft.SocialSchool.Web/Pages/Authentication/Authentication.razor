@page "/authentication/{action}"
@attribute [AllowAnonymous]
@inject WebAppSettings Settings
@inject NavigationManager Navigation

<PageTitle>SocialSchool · Acceso</PageTitle>

@if (!Settings.IsConfigured)
{
    <Alert Tone="UiTone.Warning" Title="El acceso OIDC no está configurado" IconName="lock">
        <p class="alert-text">
            Rellena <code>ApiBaseUrl</code> y <code>Oidc</code> en <code>wwwroot/appsettings.json</code>
            para activar Keycloak.
        </p>
    </Alert>
}
else
{
    <RemoteAuthenticatorView Action="@Action" OnLogInSucceeded="HandleLogInSucceeded" />
}

@code {
    /// <summary>Acción solicitada por la librería: login, logout, profile…</summary>
    [Parameter]
    public string? Action { get; set; }

    private void HandleLogInSucceeded(RemoteAuthenticationState state) =>
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(state.ReturnUrl) ? "/profile" : state.ReturnUrl);
}
