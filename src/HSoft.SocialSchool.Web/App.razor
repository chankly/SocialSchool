@inject WebAppSettings Settings

@if (Settings.IsConfigured)
{
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="page">
                    <div class="empty-state empty-state-page">
                        <span class="empty-icon"><Icon Name="compass" Size="30" /></span>
                        <h1>Esta página no existe</h1>
                        <p>La dirección que has abierto no corresponde a ninguna pantalla.</p>
                        <a class="btn btn-primary" href="">Volver al inicio</a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}
else
{
    <div class="page">
        <PageHeader Eyebrow="Configuración" Title="La aplicación no está configurada"
                    Subtitle="El cliente web solo trabaja contra el API y Keycloak: no hay datos de ejemplo." />
        <Alert Tone="UiTone.Warning" Title="Falta configuración del cliente" IconName="alert">
            <p class="alert-text">
                Rellena <code>@Settings.MissingConfiguration</code> en <code>wwwroot/appsettings.json</code>
                y recarga la página. Hacen falta <code>ApiBaseUrl</code>, <code>Oidc:Authority</code> y
                <code>Oidc:ClientId</code>.
            </p>
        </Alert>
    </div>
}
