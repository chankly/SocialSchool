@inherits LayoutComponentBase
@implements IDisposable
@inject ISessionService Session
@inject NavigationManager Navigation

<a class="skip-link" href="#main-content">Saltar al contenido</a>

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="">
            <span class="brand-mark">SS</span>
            <span class="brand-text">
                <strong>SocialSchool</strong>
                <small>cliente web · conectado al API</small>
            </span>
        </a>

        <NavMenu />

        <div class="sidebar-footer">
                <div class="sidebar-card">
                    <p class="sidebar-card-title">
                        <Icon Name="shield" Size="16" />
                        Sesión de Keycloak
                    </p>
                    <p class="sidebar-card-text">Conectado como @Session.Email.</p>
                    <button type="button" class="btn btn-sidebar" @onclick="SignOut">
                        <Icon Name="lock" Size="16" />
                        Cerrar sesión
                    </button>
                </div>
                <p class="sidebar-note">El token lo gestiona la librería OIDC; nunca se guarda a mano.</p>
        </div>
    </aside>

    <div class="app-main">
        <header class="topbar">
            <div class="session-picker">
                <span class="topbar-label">Autenticación OIDC</span>
                <p class="session-detail">
                    Sesión válida: las llamadas al API llevan el bearer automáticamente.
                </p>
            </div>

            <div class="topbar-user">
                <div class="topbar-user-text">
                    <strong>@Session.DisplayName</strong>
                    <span>
                        @(Session.RawUserType is null
                            ? "sin token · 401"
                            : $"userType «{Session.RawUserType}»")
                    </span>
                </div>
                @if (Session.AccountType is { } accountType)
                {
                    <Pill Text="@accountType.ToDisplayName()" Tone="UiTone.Brand" />
                }
                else
                {
                    <Pill Text="Sin sesión" Tone="UiTone.Neutral" Icon="lock" />
                }
                <Avatar Name="@Session.DisplayName" Size="sm" />
            </div>
        </header>

        <main id="main-content" class="page-content" tabindex="-1">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="page">
                        <Alert Tone="UiTone.Danger" Title="Algo se ha roto en esta pantalla" IconName="alert">
                            <p class="alert-text">
                                La aplicación ha capturado un error inesperado para que el resto de la navegación siga funcionando.
                            </p>
                            <button type="button" class="btn btn-outline btn-sm" @onclick="Reload">Recargar la aplicación</button>
                        </Alert>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>

        <footer class="app-footer">
            <span>SocialSchool · cliente web Blazor WebAssembly</span>
            <span>Los datos vienen del API configurado.</span>
        </footer>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        await Session.EnsureLoadedAsync();
    }

    public void Dispose() => Session.Changed -= HandleSessionChanged;

    private void HandleSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void SignOut() => Navigation.NavigateToLogout("authentication/logout");

    private void Reload() => Navigation.Refresh(true);
}
