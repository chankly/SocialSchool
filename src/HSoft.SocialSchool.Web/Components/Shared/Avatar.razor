@if (!string.IsNullOrWhiteSpace(ImageUrl))
{
    <img class="avatar avatar-@Size @CssClass" src="@ImageUrl" alt="@AltText" loading="lazy" />
}
else
{
    <span class="avatar avatar-@Size avatar-initials @CssClass" aria-hidden="true">@Initials</span>
}

@code {
    /// <summary>URL de la imagen. Si falta, se muestran las iniciales.</summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>Nombre de la persona o cuenta.</summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>Tamaño: sm, md, lg o xl.</summary>
    [Parameter]
    public string Size { get; set; } = "md";

    /// <summary>Texto alternativo de la imagen.</summary>
    [Parameter]
    public string? Alt { get; set; }

    /// <summary>Clase CSS adicional.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    private string AltText => Alt ?? Name ?? "Avatar";

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Name))
            {
                return "?";
            }

            var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return parts.Length == 1
                ? parts[0][..1].ToUpperInvariant()
                : string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant();
        }
    }
}
