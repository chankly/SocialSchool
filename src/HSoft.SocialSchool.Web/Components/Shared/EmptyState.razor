<div class="empty-state">
    <span class="empty-icon"><Icon Name="@Icon" Size="28" /></span>
    <h2>@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p>@Message</p>
    }
    @if (ChildContent is not null)
    {
        <div class="empty-actions">@ChildContent</div>
    }
</div>

@code {
    /// <summary>Icono del estado vacío.</summary>
    [Parameter]
    public string Icon { get; set; } = "compass";

    /// <summary>Título.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Descripción.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Acciones del estado vacío.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
